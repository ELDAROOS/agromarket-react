# Необязательно: по умолчанию берётся локальный DATABASE_URL из ../agromarket-server/.env.
# Пользователю БД нужно право CREATE SCHEMA. Облачные подключения запрещены.
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/agromarket

# Необязательно: временный администратор создаётся только в изолированной схеме.
# Без этих переменных email задаётся тестовым конфигом, пароль генерируется при запуске.
# E2E_FARMER_EMAIL=your-test-admin@example.test
# E2E_FARMER_PASSWORD=your-test-password
